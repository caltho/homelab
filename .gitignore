# Secrets
.env

# Runtime data / config / media — not source-controlled
data/

# Exported Caddy root CA (generated; copy for trusting on devices)
caddy-root-ca.crt

# Backup run logs
scripts/backup.log
scripts/restic-backup.log
scripts/git-backup.log

# Cloudflare Tunnel credentials, if ever copied into the repo (they normally
# live in ~/.cloudflared). cloudflared/config.yml IS tracked — it holds no secrets.
cloudflared/*.json
cloudflared/cert.pem
